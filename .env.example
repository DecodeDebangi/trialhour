# Copy to .env. All values are validated at startup (apps/api/src/config.ts).
# Postgres is published on host port 5433 (override with DB_PORT) to avoid clashing with a local Postgres.
DATABASE_URL=postgres://booking:booking@localhost:5433/booking
TEST_DATABASE_URL=postgres://booking:booking@localhost:5433/booking_test
PORT=3001
MIN_NOTICE_MINUTES=240
BOOKING_HORIZON_DAYS=14
MENTOR_DAILY_CAP=2
ASSIGNMENT_STRATEGY=capacity-preserving
# Dev only: freeze "now" for DST demos, e.g. 2027-03-13T12:00:00Z. Refused when NODE_ENV=production.
# NOW_OVERRIDE=
