{
  "name": "@codeyoung/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "start": "tsx --env-file-if-exists=../../.env src/server.ts",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/db/cli.ts migrate",
    "db:seed": "tsx --env-file-if-exists=../../.env src/db/cli.ts seed",
    "db:setup": "tsx --env-file-if-exists=../../.env src/db/cli.ts setup",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:unit": "vitest run --project unit"
  },
  "dependencies": {
    "@codeyoung/shared": "*",
    "express": "^5.3.0",
    "luxon": "^3.7.2",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/luxon": "^3.7.6",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "vitest": "^3.2.7"
  }
}
